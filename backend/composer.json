{
  "name": "mini-notes/api",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/validator": "7.4.*",
    "doctrine/dbal": "^4.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  },
  "description": "Small notes REST API with Symfony and MySQL"
}
